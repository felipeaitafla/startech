# Variáveis de ambiente do projeto. Copie para `.env.local` e preencha.

# Feedframer — API key do feed do Instagram (SECRETA, usada só no servidor).
# Pegar em https://feedframer.com (painel da conta).
FEEDFRAMER_API_KEY=

# URL pública do site (usada no metadataBase p/ a imagem OG). Opcional em dev.
# Produção: https://startechcelulares.com.br · Preview Vercel: https://startech-rho.vercel.app
NEXT_PUBLIC_SITE_URL=
